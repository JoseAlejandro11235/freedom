{$APP_SCHEME:https}://{$APP_DOMAIN} {
    encode zstd gzip

    handle /{$AWS_BUCKET}/* {
        reverse_proxy minio:9000 {
            # MinIO may emit HSTS; strip it so HTTP IP deploys don't break <img> loads in browsers.
            header_down -Strict-Transport-Security
        }
    }

    handle {
        reverse_proxy app:80
    }
}
